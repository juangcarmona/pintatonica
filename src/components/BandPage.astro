---
import Shell from '../layouts/Shell.astro';
import BrandBars from './BrandBars.astro';
import {bandArea,type BandArea} from '../band/areas';
interface Props {area:BandArea}
const current=bandArea(Astro.props.area);
---
<Shell title={`${current.label} · Backstage`} area="band">
  <section class="band-shell" data-band-area={current.id} aria-labelledby="banda-titulo">
    <p class="eyebrow brand-lockup"><BrandBars />Área privada de Pintatónica</p>
    <h1 id="banda-titulo">Backstage</h1>
    <p data-access-introduction>Acceso exclusivo para miembros de Pintatónica. Iniciar sesión no crea una membresía.</p>
    <div class="band-access">
      <p data-access-status role="status" aria-live="polite">Comprobando el acceso…</p>
      <button class="button compact" type="button" data-google-login hidden>Entrar con Google</button>
      <button class="button secondary compact" type="button" data-google-logout hidden>Salir de la cuenta</button>
    </div>
    <section data-member-dashboard hidden aria-label="Panel de la banda">
      <p class="member-greeting">Hola, <span data-member-name></span></p>
      <div data-band-workspace></div>
    </section>
    <noscript>Activa JavaScript para iniciar sesión y acceder al área privada.</noscript>
    <a class="button secondary" href="/">Volver al inicio <span aria-hidden="true">↗</span></a>
  </section>
</Shell>
<script>import '../band/browser';</script>
