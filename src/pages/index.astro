---
import Shell from '../layouts/Shell.astro';
import {publicProfile,contactLink} from '../public-site/content';
import {safeURL} from '../band/repertoire';
import BrandBars from '../components/BrandBars.astro';
const contact=contactLink(publicProfile.contact);
---
<Shell title="Pintatónica">
  <section class="hero" aria-labelledby="inicio-titulo">
    <div class="hero-story"><p class="eyebrow">Banda de música</p><h1 id="inicio-titulo">Pintatónica</h1><p class="hero-introduction">{publicProfile.introduction}</p><a class="button public-button" href="#repertorio">Nuestro repertorio <span aria-hidden="true">↓</span></a></div>
    <div class="hero-identity"><img class="band-logo" src="/brand/logo.png" alt="Pintatónica" width="1024" height="1024" fetchpriority="high" /></div>
    <BrandBars class="hero-rhythm" />
  </section>
  <section class="public-section paper-section" id="quienes-somos" tabindex="-1" aria-labelledby="banda-heading"><p class="eyebrow brand-lockup"><BrandBars />La banda</p><h2 id="banda-heading">Quiénes somos</h2><p class="introduction">{publicProfile.introduction}</p><div class="member-presentation"><h3>Quienes hacemos Pintatónica</h3>{publicProfile.members.length?<div class="public-grid">{publicProfile.members.map(member=><article class="public-card member-card" data-public-member>{member.image&&<img class="public-image" src={safeURL(member.image.url)} alt={member.image.label} loading="lazy" />}<h3>{member.name}</h3><p class="member-role">{member.role}</p>{member.description&&<p>{member.description}</p>}</article>)}</div>:<p class="public-empty">Todavía no hay una presentación pública de los miembros.</p>}</div></section>
  <section class="public-section" id="repertorio" tabindex="-1" aria-labelledby="repertorio-heading"><p class="eyebrow brand-lockup"><BrandBars />Nuestra música</p><h2 id="repertorio-heading">Repertorio</h2><div class="public-grid" data-public-music role="status" aria-live="polite"><p>Cargando repertorio…</p></div><noscript>Activa JavaScript para consultar el repertorio publicado.</noscript></section>
  <section class="public-section paper-section" id="media" tabindex="-1" aria-labelledby="media-heading"><p class="eyebrow brand-lockup"><BrandBars />Ver y escuchar</p><h2 id="media-heading">En imágenes y sonido</h2><div class="public-grid">{publicProfile.media.map(item=><article class="public-card">{item.kind==='photo'&&<img class="public-image" src={safeURL(item.url)} alt={item.label} loading="lazy" />}<a href={safeURL(item.url)} target="_blank" rel="noopener noreferrer">{item.label}</a></article>)}</div>{!publicProfile.media.length&&<p class="public-empty">Todavía no hay fotos o vídeos publicados.</p>}<div class="media-links" data-public-song-media role="status" aria-live="polite"><p>Cargando enlaces…</p></div><noscript>Activa JavaScript para consultar los enlaces publicados.</noscript></section>
  <section class="public-section" id="conciertos" tabindex="-1" aria-labelledby="conciertos-heading"><p class="eyebrow brand-lockup"><BrandBars />En directo</p><h2 id="conciertos-heading">Próximos conciertos</h2><div class="public-grid" data-public-gigs role="status" aria-live="polite"><p>Cargando conciertos…</p></div><noscript>Activa JavaScript para consultar los conciertos publicados.</noscript></section>
  <section class="public-section paper-section" id="contacto" tabindex="-1" aria-labelledby="contacto-heading"><p class="eyebrow brand-lockup"><BrandBars />Hablemos</p><h2 id="contacto-heading">Contacto</h2>{contact?<a class="button public-button" href={contact}>{publicProfile.contact!.label}</a>:<p class="public-empty">Todavía no hay un contacto público disponible.</p>}</section>
</Shell>
<script>import '../public-site/browser';</script>
