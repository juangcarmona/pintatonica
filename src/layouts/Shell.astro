---
import '../styles/tokens.css';
import '../styles/shell.css';
import BrandBars from '../components/BrandBars.astro';
interface Props { title: string; area?: 'public' | 'band' }
const { area = 'public', title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Pintatónica: la banda, su repertorio y próximos conciertos." />
    <title>{area==='band'?`${title} · Pintatónica`:'Pintatónica'}</title>
    <link rel="icon" type="image/png" href="/brand/logo.png" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Pintatónica, inicio">Pintatónica</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Abrir navegación" aria-controls="site-navigation" aria-expanded="false" hidden><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
      <nav id="site-navigation" aria-label="Principal">
        <a href={area === 'public' ? '#inicio' : '/#inicio'} data-public-area={area === 'public' ? 'inicio' : undefined}>Inicio</a>
        <a href={area === 'public' ? '#quienes-somos' : '/#quienes-somos'} data-public-area={area === 'public' ? 'quienes-somos' : undefined}>La banda</a>
        <a href={area === 'public' ? '#repertorio' : '/#repertorio'} data-public-area={area === 'public' ? 'repertorio' : undefined}>Repertorio</a>
        <a href={area === 'public' ? '#media' : '/#media'} data-public-area={area === 'public' ? 'media' : undefined}>Media</a>
        <a href={area === 'public' ? '#conciertos' : '/#conciertos'} data-public-area={area === 'public' ? 'conciertos' : undefined}>Conciertos</a>
        <a href={area === 'public' ? '#contacto' : '/#contacto'} data-public-area={area === 'public' ? 'contacto' : undefined}>Contacto</a>
        <a class="backstage-link" href="/band/" aria-current={area === 'band' ? 'page' : undefined}>{area === 'public' ? 'Backstage · Entrar' : 'Backstage'}</a>
      </nav>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer"><span class="brand-lockup"><BrandBars />Pintatónica</span><a href="/#contacto">Contacto</a><a href="/band/">{area === 'public' ? 'Backstage · Entrar' : 'Backstage'} <span aria-hidden="true">↗</span></a></footer>
    <script>
      import '../public-site/navigation';
      import { initializeBrowserFirebase } from '../firebase/browser';
      void initializeBrowserFirebase().catch((error: unknown) => {
        // Report only a diagnostic code; SDK errors can include configuration.
        const code = error && typeof error === 'object' && 'code' in error ? error.code : 'initialization-failed';
        console.warn('Firebase initialization unavailable:', code);
      });
    </script>
  </body>
</html>
