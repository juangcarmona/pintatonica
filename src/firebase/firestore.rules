rules_version = '2';

// Deny by default. Private access = Google-authenticated user + active members/{uid} record (BR-MEMBERSHIP).
// Members are provisioned out of band (Console/Admin); clients never write members.
service cloud.firestore {
  match /databases/{database}/documents {

    function isGoogleIdentity() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMember() {
      return isGoogleIdentity()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function isSelf(uid) {
      return isGoogleIdentity() && request.auth.uid == uid;
    }

    // A user may read only their own record, so the app can tell whether they are a member.
    // Active members may read the roster.
    match /members/{uid} {
      allow read: if isSelf(uid) || isMember();
      allow write: if false;
    }

    // availability/{uid}: weekly pattern (intervals as {day, start, end}).
    // availability/{uid}/overrides/{date}: date override; empty intervals means unavailable.
    // Members read everyone's availability (overlap calculation) and write only their own.
    match /availability/{uid} {
      allow read: if isMember();
      allow write: if isMember() && isSelf(uid);

      match /overrides/{date} {
        allow read: if isMember();
        allow write: if isMember() && isSelf(uid);
      }
    }

    // Active members may confirm rehearsals under BR-REHEARSAL-CONFIRMATION.
    match /rehearsals/{id} {
      allow read, write: if isMember();
    }

    match /setlists/{id} {
      allow read, write: if isMember();
    }

    function songProjection(song) {
      return {'title': song.title, 'artist': song.artist, 'mediaUrl': song.publicMediaUrl};
    }

    match /songs/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.public is bool
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && request.resource.data.publicMediaUrl is string
        && (request.resource.data.public
          ? getAfter(/databases/$(database)/documents/publicSongs/$(id)).data == songProjection(request.resource.data)
          : !existsAfter(/databases/$(database)/documents/publicSongs/$(id)));
      allow delete: if isMember() && !existsAfter(/databases/$(database)/documents/publicSongs/$(id));
    }

    // Public documents are explicit whitelists, never field-filtered private records.
    match /publicSongs/{id} {
      allow read: if true;
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'artist', 'mediaUrl'])
        && getAfter(/databases/$(database)/documents/songs/$(id)).data.public == true
        && request.resource.data == songProjection(getAfter(/databases/$(database)/documents/songs/$(id)).data);
      allow delete: if isMember()
        && (!existsAfter(/databases/$(database)/documents/songs/$(id))
          || getAfter(/databases/$(database)/documents/songs/$(id)).data.public == false);
    }
  }
}
