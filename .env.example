# Firebase Web SDK configuration: PUBLIC browser configuration, safe to expose and commit.
# Access control is enforced by Firestore security rules (src/firebase/firestore.rules), not by hiding these.
PUBLIC_FIREBASE_API_KEY=<firebase-browser-api-key>
PUBLIC_FIREBASE_AUTH_DOMAIN=<firebase-auth-domain>
PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
PUBLIC_FIREBASE_STORAGE_BUCKET=<optional-storage-bucket>
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<optional-messaging-sender-id>
PUBLIC_FIREBASE_APP_ID=<firebase-web-app-id>

# Local development only: route Auth and Firestore to the emulators (ignored in production builds).
PUBLIC_FIREBASE_USE_EMULATORS=false

# NEVER put in PUBLIC_ variables or commit: service-account keys, GOOGLE_APPLICATION_CREDENTIALS,
# OAuth client secrets, Admin SDK credentials, deploy tokens.
